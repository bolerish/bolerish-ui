{
  "name": "@bolerish/ui",
  "version": "0.9.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/nueexyz/ui.git"
  },
  "bin": {
    "bolerish": "./dist/cli.js"
  },
  "files": [
    "configuration_schema.json",
    "dist"
