    "./label": "./dist/label.js",
    "./link": "./dist/link.js",
    "./menubar": "./dist/menubar.js",
    "./marker": "./dist/marker.js",
    "./message": "./dist/message.js",
    "./native-select": "./dist/native-select.js",
    "./navigation-menu": "./dist/navigation-menu.js",
    "./popover": "./dist/popover.js",
    "./pagination": "./dist/pagination.js",
    "./progress": "./dist/progress.js",
