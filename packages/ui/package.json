    "./switch": "./dist/switch.js",
    "./table": "./dist/table.js",
    "./tabs": "./dist/tabs.js",
    "./timeline": "./dist/timeline.js",
    "./textarea": "./dist/textarea.js",
    "./toast": "./dist/toast.js",
    "./toggle": "./dist/toggle.js",
    "./toggle-group": "./dist/toggle-group.js",
    "./tooltip": "./dist/tooltip.js",
    "./heading": "./dist/heading.js",
    "./p": "./dist/p.js",
    "./theme": "./dist/theme.js",
    "./paragraph": "./dist/paragraph.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @bolerish/cli build && node --experimental-strip-types scripts/build.ts && tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json",
    "prepack": "pnpm build",
    "test": "pnpm build && node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cli.json --noEmit && pnpm build && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@bolerish/cli": "workspace:*",
    "@bolerish/tokens": "workspace:*",
    "@daypicker/react": "^10.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.0",
    "embla-carousel-react": "^8.6.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "catalog:2026-08-27-stable",
    "@types/node": "catalog:2026-08-27-stable",
    "@types/react": "catalog:2026-08-27-stable",
    "@types/react-dom": "catalog:2026-08-27-stable",
    "babel-plugin-react-compiler": "catalog:2026-08-27-stable",
    "esbuild": "0.28.2",
