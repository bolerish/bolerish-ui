{
  "name": "@bolerish/cli",
  "version": "0.12.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/myjeong19/ui.git"
  },
  "bin": {
    "bolerish": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @bolerish/registry build && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "pnpm build && node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit && pnpm build && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@babel/types": "7.29.8",
    "@bolerish/registry": "workspace:*",
    "get-tsconfig": "^4.14.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "catalog:2026-08-27-stable",
    "typescript": "catalog:2026-08-27-stable"
  }
}
