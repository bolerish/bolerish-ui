{
  "name": "@bolerish/tokens",
  "version": "0.16.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myjeong19/bolerish-ui.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./color-palette": "./src/color-palette.stylex.ts",
    "./density.stylex": "./src/density.stylex.ts",
    "./themes.stylex": "./src/themes.stylex.ts",
    "./semantic.stylex": "./src/semantic.stylex.ts",
    "./tokens.stylex": "./src/semantic.stylex.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "palette:check": "node --experimental-strip-types palette/generate-palette.ts --check",
    "palette:generate": "node --experimental-strip-types palette/generate-palette.ts",
    "test": "node --experimental-strip-types --experimental-vm-modules --test palette/*.test.ts src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@stylexjs/stylex": "catalog:2026-08-27-stable",
    "typescript": "catalog:2026-08-27-stable"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "^0.19.0"
  }
}
