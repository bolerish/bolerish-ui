{
  "name": "@bolerish/docs-mcp",
  "version": "0.0.0",
  "description": "Read-only MCP tools for bolerish components, examples, tokens and guidelines.",
  "homepage": "https://ui.bolerish.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myjeong19/bolerish-ui.git",
    "directory": "packages/docs-mcp"
  },
  "bin": {
    "bolerish-docs-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "pnpm build && node --experimental-strip-types --test src/*.test.ts package.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "catalog:2026-08-27-stable",
    "typescript": "catalog:2026-08-27-stable"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
