{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["docs/src/routeTree.gen.ts"],
  "plugins": [
    "oxc",
    "unicorn",
    "typescript",
    "promise",
    "react",
    "react-perf",
    "jsx-a11y",
    "jsdoc",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "jsPlugins": [
    {
      "name": "bolerish-ui",
      "specifier": "./packages/eslint-plugin-ui/dist/index.js"
    }
  ],
  "overrides": [
    {
      "files": ["packages/ui/src/**/*.{ts,tsx}", "docs/src/**/*.{ts,tsx}"],
      "rules": {
        "bolerish-ui/color-tokens": "warn",
        "bolerish-ui/typography-tokens": "warn",
        "bolerish-ui/spacing-tokens": "warn"
      }
    }
  ]
}
