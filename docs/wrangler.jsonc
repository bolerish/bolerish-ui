{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bolerish-docs",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
