{
  "name": "@bolerish/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types scripts/build-guidelines.ts && pnpm --filter @bolerish/ui build && vite build",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "node --experimental-strip-types scripts/build-guidelines.ts && pnpm --filter @bolerish/ui build && vite --port 3000",
    "lint": "pnpm --filter @bolerish/eslint-plugin-ui build && pnpm --workspace-root exec oxlint docs/src",
    "preview": "vite preview --port 3000",
    "test:agent": "node --experimental-strip-types scripts/build-guidelines.ts --check && node --experimental-strip-types --test scripts/build-guidelines.test.ts src/documentation/settings.test.ts src/documentation/paths.test.ts src/documentation/catalog.test.ts src/foundations/guidelines.test.ts src/documentation/table-headers.test.ts",
    "test:runtime": "node --experimental-strip-types --test test/runtime.test.ts",
    "typecheck": "pnpm --filter @bolerish/ui build && tsc --noEmit"
  },
  "dependencies": {
    "@bolerish/tokens": "workspace:*",
    "@bolerish/ui": "workspace:*",
    "@phosphor-icons/react": "catalog:2026-08-27-stable",
    "@stylexjs/stylex": "catalog:2026-08-27-stable",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "prism-react-renderer": "^2.4.1",
    "react": "catalog:2026-08-27-stable",
    "react-dom": "catalog:2026-08-27-stable"
  },
  "devDependencies": {
    "@bolerish/eslint-plugin-ui": "workspace:*",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@stylexjs/unplugin": "catalog:2026-08-27-stable",
    "@types/node": "^26.6.5",
    "@types/react": "catalog:2026-08-27-stable",
    "@types/react-dom": "catalog:2026-08-27-stable",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "catalog:2026-08-27-stable",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "catalog:2026-08-27-stable",
    "vite": "catalog:2026-08-27-stable",
    "wrangler": "^4.151.3"
  }
}
