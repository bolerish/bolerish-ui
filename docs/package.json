{
  "name": "@nuee/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build-storybook": "node scripts/build-guidelines.mjs && pnpm --filter @nuee/ui build && storybook build",
    "storybook": "node scripts/build-guidelines.mjs && pnpm --filter @nuee/ui build && storybook dev -p 6006",
    "test:agent": "node scripts/build-guidelines.mjs --check && node --test scripts/agent.test.mjs",
    "typecheck": "pnpm --filter @nuee/ui build && tsc --noEmit"
  },
  "dependencies": {
    "@nuee/tokens": "workspace:*",
    "@nuee/ui": "workspace:*",
    "@phosphor-icons/react": "catalog:2026-08-27-stable",
    "@stylexjs/stylex": "catalog:2026-08-27-stable",
    "react": "catalog:2026-08-27-stable",
    "react-dom": "catalog:2026-08-27-stable"
  },
  "devDependencies": {
    "@mdx-js/react": "3.1.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@stylexjs/unplugin": "catalog:2026-08-27-stable",
    "@types/react": "catalog:2026-08-27-stable",
    "@types/react-dom": "catalog:2026-08-27-stable",
    "babel-plugin-react-compiler": "catalog:2026-08-27-stable",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.0",
    "typescript": "catalog:2026-08-27-stable",
    "vite": "catalog:2026-08-27-stable"
  }
}
