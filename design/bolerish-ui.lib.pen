    {
      "type": "context",
      "id": "t0Q4e2",
      "x": 1304,
      "y": 0,
      "name": "React bindings and source of truth",
      "width": 800,
      "height": 240,
      "content": "Use the connected workspace and existing React + TypeScript + StyleX components.\nButton: @bolerish/ui/button, primary or ghost, size md.\nInput: @bolerish/ui/input, variant outline.\nAccount form: compose Card, CardHeader, CardTitle, CardDescription, CardContent and CardFooter from @bolerish/ui/card; source example is docs/src/app/(site)/docs/_content/components/card/AccountCreationForm.tsx.\nColor and dimension tokens come from packages/tokens/src/semantic.stylex.ts and themes.stylex.ts. Read those sources before generating code; reuse the package exports instead of reimplementing controls.\nThis library is a 0.16.0 design snapshot. Code-to-library synchronization is manual. System fonts are represented by Roboto. Compact instance geometry is a resolved numeric snapshot."
    }
  ],
  "themes": {
    "mode": [
      "light",
      "dark"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "variables": {
    "colorVars.bgCanvas": {
      "type": "color",
      "value": [
        {
          "value": "#EEEEEE",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#08090A",
          "theme": {
            "mode": "dark"
          }
        }
      ]
    },
    "colorVars.bgSurface": {
      "type": "color",
      "value": [
        {
          "value": "#FFFFFF",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#0F1011",
          "theme": {
            "mode": "dark"
          }
        }
      ]
    },
